[Unit]
Description=ROS 2 counter demo (counter_publisher + counter_subscriber)
After=network.target

[Service]
Type=simple
# systemd services get no login environment: give ROS a home and a log folder, then load the ROS setup.
Environment=HOME=/root
Environment=ROS_LOG_DIR=/var/log/ros
# /var/log is in RAM (emptied at every boot): systemd recreates /var/log/ros before each start.
LogsDirectory=ros
ExecStart=/bin/sh -c '. /etc/profile.d/ros-setup.sh && exec ros2 launch counter_demo counter_demo.launch.py'
# ros2 launch exits with 0 even when its node crashed, so restart on any exit.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
