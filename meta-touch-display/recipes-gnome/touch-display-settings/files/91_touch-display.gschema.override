# GNOME defaults for the 3.5" 320x480 touch screen.
# GNOME's dialogs are made for bigger screens: at 100% text the bottom of e.g. the Power Off dialog (its buttons) is
# below the screen edge. 80% text makes them fit (checked on the board).
[org.gnome.desktop.interface]
text-scaling-factor=0.8

# The dash (favourites): Camera, the web browser (GNOME Web), Files, Text Editor and the terminal.
[org.gnome.shell]
favorite-apps=['io.github.nvovka1.DetectionCamera.desktop', 'org.gnome.Epiphany.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Console.desktop']

# The screen shows the camera, so it stays on: no blanking after 5 minutes idle, no dimming, no lock screen (waking
# from a blank screen showed the lock screen's wallpaper, which looked like a frozen camera picture), no suspend.
[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.screensaver]
lock-enabled=false
idle-activation-enabled=false

[org.gnome.settings-daemon.plugins.power]
idle-dim=false
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

# GNOME Web opens this page in new windows and tabs.
[org.gnome.Epiphany]
homepage-url='https://uakino.best/'
